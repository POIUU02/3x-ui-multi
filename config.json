{
  "_comment": "Central configuration for X-UI + Tor multi-country gateway - OPTIMIZED FOR SPEED",

  "api": {
    "_comment": "External IP/country lookup API - minimal timeouts for speed",
    "base_url": "https://dry-thunder-684c.4j89drj49rd-14070.workers.dev",
    "endpoints": {
      "tor_check": "/tor-check",
      "lookup": "/lookup",
      "detect": "/detect",
      "countries": "/countries",
      "ips_txt": "/ips.txt"
    },
    "timeout": 2,
    "retry_attempts": 1
  },

  "tor": {
    "_comment": "MAXIMUM SPEED - minimal rotation, no retry delays",
    "rotate_seconds": 60,
    "strict_nodes": false,
    "bootstrap_timeout": 30,
    "verify_max_retries": 3,
    "verify_retry_sleep": 1,
    "circuit_settle_sleep": 1,
    "parallel_bootstrap": true,
    "parallel_verify": true,

    "exclude_countries": [],

    "countries": [
      { "code": "ca", "label": "Canada",         "port": 9050, "control_port": 9150, "inbound_port": 8081, "path": "/in1"  },
      { "code": "tr", "label": "Turkey",          "port": 9051, "control_port": 9151, "inbound_port": 8082, "path": "/in2"  },
      { "code": "de", "label": "Germany",         "port": 9052, "control_port": 9152, "inbound_port": 8083, "path": "/in3"  },
      { "code": "fr", "label": "France",          "port": 9053, "control_port": 9153, "inbound_port": 8084, "path": "/in4"  },
      { "code": "se", "label": "Sweden",          "port": 9054, "control_port": 9154, "inbound_port": 8085, "path": "/in5"  },
      { "code": "ch", "label": "Switzerland",     "port": 9055, "control_port": 9155, "inbound_port": 8086, "path": "/in6"  },
      { "code": "fi", "label": "Finland",         "port": 9056, "control_port": 9156, "inbound_port": 8087, "path": "/in7"  },
      { "code": "gb", "label": "United Kingdom",  "port": 9057, "control_port": 9157, "inbound_port": 8088, "path": "/in8"  },
      { "code": "es", "label": "Spain",           "port": 9058, "control_port": 9158, "inbound_port": 8089, "path": "/in9"  },
      { "code": "ro", "label": "Romania",         "port": 9059, "control_port": 9159, "inbound_port": 8090, "path": "/in10" },
      { "code": "ae", "label": "Dubai",           "port": 9060, "control_port": 9160, "inbound_port": 8091, "path": "/in11" }
    ],

    "verification": {
      "enabled": true,
      "check_interval": 10,
      "max_failures": 2,
      "test_urls": [
        "https://api.ipify.org",
        "https://icanhazip.com"
      ],
      "geoip_providers": [
        "ip-api.com",
        "ipinfo.io"
      ]
    }
  },

  "xui": {
    "internal_port": 2053,
    "web_base_path": "/managepanel",
    "default_username": "admin",
    "default_password": "admin"
  },

  "direct": {
    "_comment": "Direct (non-Tor) egress - ultra fast",
    "enabled": true,
    "port": 8080,
    "path": "/direct",
    "tag": "direct-inbound"
  },

  "server": {
    "_comment": "Single public-facing port",
    "public_port": 3000
  }
}
